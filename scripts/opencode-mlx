#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export OPENCODE_CONFIG="$ROOT_DIR/opencode.jsonc"
PYTHON_BIN="$ROOT_DIR/.venv/bin/python"
if [[ -x "$PYTHON_BIN" ]]; then
  MLX_MODEL_API_KEY="$("$PYTHON_BIN" -m mlx_lab.cli api-key --if-configured)"
else
  MLX_MODEL_API_KEY="$(uv run python -m mlx_lab.cli api-key --if-configured)"
fi
export MLX_MODEL_API_KEY="${MLX_MODEL_API_KEY:-local-mlx}"

usage() {
  cat <<'EOF'
Usage: scripts/opencode-mlx <target> [opencode args...]

Targets:
  primary         Qwen3 Coder 30B 8-bit as the normal opencode Build/tool agent
  qwen            Qwen Coder Next 4-bit as the fast fallback Build/tool agent
  qwen-chat       Qwen Coder Next 4-bit as chat-only
  qwen30          Qwen3 Coder 30B 8-bit as the normal opencode Build/tool agent
  qwen30-chat     Qwen3 Coder 30B 8-bit as chat-only
  qwen-coder-next8 Qwen3 Coder Next 8-bit as the normal opencode Build/tool agent
  qwen-coder-next8-chat Qwen3 Coder Next 8-bit as chat-only
  qwen-next80     Qwen3 Next 80B A3B 8-bit as chat-only
  gemma           Gemma 4 31B as chat-only
  gemma-coder     Gemma 4 12B Coder 8-bit as an experimental tool agent
  deepseek        DeepSeek R1 Distill Qwen 32B 4-bit as chat-only
  deepseek8       DeepSeek R1 Distill Qwen 32B 8-bit as chat-only
  qwen-oblit      Qwen3.6 27B Obliterated as chat-only
  ravenx          RavenX CyberAgent Qwen3.6 35B A3B as chat-only
  models          List configured MLX models

Examples:
  scripts/opencode-mlx primary
  scripts/opencode-mlx qwen
  scripts/opencode-mlx qwen30
  scripts/opencode-mlx qwen-coder-next8
  scripts/opencode-mlx qwen-next80
  scripts/opencode-mlx ravenx
  scripts/opencode-mlx deepseek --continue
EOF
}

if [[ $# -lt 1 ]]; then
  usage
  exit 2
fi

target="$1"
shift

case "$target" in
  primary)
    exec opencode -m local-mlx/qwen3-coder-30b-8bit "$@"
    ;;
  gemma|gemma-chat)
    exec opencode --agent gemma-chat "$@"
    ;;
  gemma-coder|gemma-coder-chat|gemma12-coder)
    exec opencode --agent gemma-coder-chat "$@"
    ;;
  qwen|qwen-build|build)
    exec opencode -m local-mlx/qwen3-coder-next "$@"
    ;;
  qwen-chat)
    exec opencode --agent qwen-chat "$@"
    ;;
  qwen30|qwen30-build|qwen-30b|qwen-30b-build)
    exec opencode -m local-mlx/qwen3-coder-30b-8bit "$@"
    ;;
  qwen30-chat|qwen-30b-chat)
    exec opencode --agent qwen30-chat "$@"
    ;;
  qwen-coder-next8|qwen-coder-next8-build|qwen3-coder-next-8bit|qwen3-coder-next-8bit-build)
    exec opencode -m local-mlx/qwen3-coder-next-8bit "$@"
    ;;
  qwen-coder-next8-chat|qwen3-coder-next-8bit-chat)
    exec opencode --agent qwen-coder-next8-chat "$@"
    ;;
  qwen-next80|qwen-next80-chat|qwen3-next-80b|qwen3-next-80b-chat)
    exec opencode --agent qwen-next80-chat "$@"
    ;;
  deepseek|deepseek-chat|deepseek4)
    exec opencode --agent deepseek-chat "$@"
    ;;
  deepseek8|deepseek8-chat|deepseek-8bit)
    exec opencode --agent deepseek8-chat "$@"
    ;;
  qwen-oblit|qwen-oblit-chat)
    exec opencode --agent qwen-oblit-chat "$@"
    ;;
  ravenx|ravenx-chat|ravenx-cyberagent|ravenx-rath)
    exec opencode --agent ravenx-chat "$@"
    ;;
  models|list)
    exec "$(dirname "$0")/mlx-server" models
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "Unknown target: $target" >&2
    usage >&2
    exit 2
    ;;
esac
