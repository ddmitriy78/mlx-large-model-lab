{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-mlx/qwen3-coder-30b-8bit",
  "small_model": "local-mlx/active-small",
  "agent": {
    "qwen-chat": {
      "description": "Chat-only Qwen Coder without opencode tool access.",
      "model": "local-mlx/qwen3-coder-next",
      "mode": "primary",
      "maxSteps": 1,
      "prompt": "You are running as a chat-only local model. Answer directly in normal text. Do not call tools, do not emit XML tool_call blocks, and do not mention unavailable tools.",
      "tools": {
        "invalid": false,
        "question": false,
        "bash": false,
        "read": false,
        "glob": false,
        "grep": false,
        "edit": false,
        "write": false,
        "task": false,
        "webfetch": false,
        "todowrite": false,
        "skill": false
      }
    },
    "qwen30-chat": {
      "description": "Chat-only Qwen3 Coder 30B 8-bit without opencode tool access.",
