  "provider": {
    "local-mlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local MLX",
      "options": {
        "baseURL": "http://127.0.0.1:48080/v1",
        "apiKey": "local-mlx",
        "timeout": 1800000,
        "chunkTimeout": 600000
      },
      "models": {
        "qwen3-coder-next": {
