        "edit": false,
        "write": false,
        "task": false,
        "webfetch": false,
        "todowrite": false,
        "skill": false
      }
    },
    "gemma-chat": {
      "description": "Chat-only Gemma agent without opencode tool access.",
      "model": "local-mlx/gemma-4-31b-it-optiq",
      "mode": "primary",
      "maxSteps": 1,
      "prompt": "You are running as a chat-only local model. Answer directly in normal text. Do not call tools, do not emit XML tool_call blocks, and do not mention unavailable tools.",
      "tools": {
        "invalid": false,
        "question": false,
        "bash": false,
        "read": false,
        "glob": false,
        "grep": false,
        "edit": false,
        "write": false,
        "task": false,
        "webfetch": false,
        "todowrite": false,
        "skill": false
      }
    },
    "gemma-coder-chat": {
      "description": "Experimental tool-capable Gemma 4 12B Coder 8-bit agent.",
      "model": "local-mlx/gemma-4-12b-coder-8bit",
      "mode": "primary",
      "prompt": "You are running local coding model Gemma 4 12B Coder 8-bit. Answer directly in normal text. Call tools as necessary, write code directly, delete unnecessary code, and do not emit XML tool_call blocks. Do not mention unavailable tools.",
      "tools": {
        "invalid": false,
        "question": true,
        "bash": true,
        "read": true,
        "glob": true,
        "grep": true,
        "edit": true,
        "write": true,
        "task": true,
        "webfetch": true,
        "todowrite": true,
        "skill": true
      }
    },
    "deepseek-chat": {
