      "description": "Chat-only DeepSeek R1 Distill Qwen 32B 8-bit agent without opencode tool access.",
      "model": "local-mlx/deepseek-r1-qwen-32b-8bit",
      "mode": "primary",
      "maxSteps": 1,
      "prompt": "You are running as a chat-only local model. Answer directly in normal text. Do not call tools, do not emit XML tool_call blocks, and do not mention unavailable tools.",
